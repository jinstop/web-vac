---
// GDPR cookie consent banner.
// The site sets no tracking cookies today; the banner documents consent
// state and gates any future non-essential storage via window.qovCookieConsent.
---

<div id="cookie-consent" class="cc" role="dialog" aria-live="polite" aria-label="Cookie consent" hidden>
  <div class="cc__inner">
    <div class="cc__text">
      <strong>We use minimal cookies</strong>
      <p>
        This site does not use advertising or tracking cookies. We store your
        consent choice in local storage, and any optional features (such as
        embedded content) will only load after you accept. See our
        <a href="/privacy">Privacy &amp; Cookie Policy</a>.
      </p>
    </div>
    <div class="cc__actions">
      <button id="cc-accept" class="btn btn--primary" type="button">Accept</button>
      <button id="cc-decline" class="btn btn--ghost" type="button">Decline</button>
    </div>
  </div>
</div>

<style>
  .cc {
    position: fixed;
    inset: auto 16px 16px 16px;
    z-index: 90;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }
  .cc[hidden] {
    display: none;
  }
  .cc__inner {
    pointer-events: auto;
    max-width: 720px;
    background: var(--surface-dark, #10202f);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
    padding: 18px 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px 24px;
    align-items: center;
  }
  .cc__text {
    flex: 1 1 320px;
  }
  .cc__text strong {
    display: block;
    font-size: 0.95rem;
    margin-bottom: 4px;
  }
  .cc__text p {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.78);
  }
  .cc__text a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cc__actions {
    display: flex;
    gap: 10px;
    flex: none;
  }
  @media (max-width: 560px) {
    .cc {
      inset: auto 8px 8px 8px;
    }
    .cc__actions {
      width: 100%;
    }
    .cc__actions .btn {
      flex: 1;
    }
  }
</style>

<script>
  const STORAGE_KEY = 'qov-cookie-consent';

  const banner = document.getElementById('cookie-consent');

  function setConsent(value: 'granted' | 'denied') {
    try {
      localStorage.setItem(STORAGE_KEY, value);
    } catch {
      /* storage unavailable (private mode) - banner will reappear next visit */
    }
    if (banner) banner.hidden = true;
  }

  if (banner) {
    let stored: string | null = null;
    try {
      stored = localStorage.getItem(STORAGE_KEY);
    } catch {
      stored = null;
    }
    if (!stored) banner.hidden = false;

    document.getElementById('cc-accept')?.addEventListener('click', () => setConsent('granted'));
    document.getElementById('cc-decline')?.addEventListener('click', () => setConsent('denied'));
  }

  // Footer "Cookie Settings" link re-opens the banner so consent can be withdrawn.
  document.querySelectorAll('[data-cookie-settings]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      if (banner) {
        banner.hidden = false;
        banner.scrollIntoView({ behavior: 'smooth', block: 'end' });
      }
    });
  });
</script>
