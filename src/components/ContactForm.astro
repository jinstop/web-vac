---
import { site } from '../config/site';
import { categories } from '../data/products';

const formsubmitEndpoint = 'https://formsubmit.co/vax@levuzo.com';
---

<section class="section">
  <div class="container contact-layout">
    <div class="contact-form">
      <h2 style="font-size:1.4rem;font-weight:700;margin-bottom:8px">Send an Inquiry</h2>
      <p style="color:var(--text-muted);margin-bottom:24px">
        Tell us your parts, load size, and cycle requirements — our engineering team will
        propose a furnace configuration and quotation.
      </p>
      <form id="inquiry-form" action={formsubmitEndpoint} method="POST">
        <input type="hidden" name="_subject" value="New Furnace Inquiry - VAX Website" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="true" />
        <input type="hidden" name="_next" value={`${site.domain}/thank-you`} />
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
        <input type="hidden" name="Submission Time" />
        <input type="hidden" name="Source Page" />
        <input type="hidden" name="IP Address" />
        <input type="hidden" name="User Agent" />
        <div class="form-grid">
          <div class="form-field">
            <label for="name">Name *</label>
            <input id="name" name="Name" type="text" required autocomplete="name" />
          </div>
          <div class="form-field">
            <label for="company">Company</label>
            <input id="company" name="Company" type="text" autocomplete="organization" />
          </div>
          <div class="form-field">
            <label for="email">Email *</label>
            <input id="email" name="Email" type="email" required autocomplete="email" />
          </div>
          <div class="form-field">
            <label for="phone">Phone *</label>
            <input id="phone" name="Phone" type="tel" required autocomplete="tel" />
          </div>
          <div class="form-field form-field--full">
            <label for="product">Product of Interest</label>
            <select id="product" name="Product">
              <option value="">Select a furnace type</option>
              {
                categories.map((c) => (
                  <option value={c.title}>{c.title}</option>
                ))
              }
              <option value="Other / Custom">Other / Custom</option>
            </select>
          </div>
          <div class="form-field form-field--full">
            <label for="message">Requirements *</label>
            <textarea id="message" name="Requirements" required placeholder="Part material & dimensions, batch weight, required temperature / vacuum level, cycle time, site constraints…"></textarea>
          </div>
        </div>
        <div class="btn-row" style="margin-top:22px">
          <button class="btn btn--primary btn--lg" type="submit">Send Inquiry</button>
        </div>
        <p class="form-note">
          Submitting sends your details to our sales team — typical response within
          one business day.
        </p>
      </form>
    </div>

    <aside class="contact-aside">
      <div class="contact-card">
        <h3>
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M3 7h18v12H3zM3 7l9 7 9-7" /></svg>
          Email Us
        </h3>
        <p>
          <a href={`mailto:${site.email}`}>{site.email}</a><br />
          Typical response within one business day.
        </p>
      </div>
      <div class="contact-card">
        <h3>
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M10 3a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM3 10h14M10 3c2 2.2 2 9.8 0 14M10 3C8 5.2 8 9.8 0 14M10 3C8 5.2 8 9.8 0 14" /></svg>
          Global Service
        </h3>
        <p>
          Installation supervision, operator training and spare-parts support for
          furnaces delivered worldwide.
        </p>
      </div>
      <div class="contact-card">
        <h3>
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M10 4a6 6 0 1 0 0 12 6 6 0 0 0 0-12zM10 9v5M10 6.5v.01" /></svg>
          Custom Engineering
        </h3>
        <p>
          Every furnace is configured to your parts, load size and cycle — from
          laboratory scale to full production lines.
        </p>
      </div>
    </aside>
  </div>
</section>

<script>
  // FormSubmit has no native fields for submission metadata, so we attach it
  // as hidden form fields right before the POST: timestamp, source page,
  // IP address (via ipify, with timeout + fallback) and user agent.
  const form = document.getElementById('inquiry-form') as HTMLFormElement | null;

  if (form) {
    let submitting = false;

    const field = (name: string) =>
      form.querySelector<HTMLInputElement>(`input[name="${name}"]`);

    const localTimestamp = () => {
      const now = new Date();
      const pad = (n: number) => String(n).padStart(2, '0');
      const offsetMinutes = -now.getTimezoneOffset();
      const sign = offsetMinutes >= 0 ? '+' : '-';
      const abs = Math.abs(offsetMinutes);
      const utc = `UTC${sign}${pad(Math.floor(abs / 60))}:${pad(abs % 60)}`;
      return (
        `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())} ` +
        `${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())} (${utc})`
      );
    };

    form.addEventListener('submit', async (event) => {
      if (submitting) {
        event.preventDefault();
        return;
      }
      event.preventDefault();
      submitting = true;

      const time = field('Submission Time');
      if (time) time.value = localTimestamp();
      const page = field('Source Page');
      if (page) page.value = window.location.href;
      const agent = field('User Agent');
      if (agent) agent.value = navigator.userAgent;

      const ip = field('IP Address');
      if (ip) {
        ip.value = 'unavailable';
        try {
          const controller = new AbortController();
          const timer = setTimeout(() => controller.abort(), 3000);
          const response = await fetch('https://api.ipify.org?format=json', {
            signal: controller.signal
          });
          clearTimeout(timer);
          const data = await response.json();
          if (data && typeof data.ip === 'string') ip.value = data.ip;
        } catch {
          /* lookup failed or blocked - keep fallback and submit anyway */
        }
      }

      form.submit();
    });
  }
</script>
